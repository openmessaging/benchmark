QUEEN_RAFT_REPLICATOR=openraft
QUEEN_RAFT_NODE_ID={{ nodeId }}
QUEEN_RAFT_PEERS={{ peers }}
QUEEN_RAFT_TOKEN={{ raftToken }}
QUEEN_RAFT_DIR=/var/lib/queen/raft
QUEEN_RAFT_LISTEN={{ privateIp }}:7400
QUEEN_BIND_ADDR={{ privateIp }}
PORT=6632
QUEEN_SERVER_ID=queen-{{ nodeId }}
# For the workloads with thousands of topics, on a new data directory: every queue on one of 16
# shared logs, so a write fsyncs at most 16 files however many queues it touches.
# QUEEN_QLOG_SHARDS=16
